<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Open Claude Chat</name>
  <id>org.inkscape_claude.claude_chat</id>

  <effect needs-live-preview="false" needs-document="true" implements-custom-gui="true">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Claude"/>
    </effects-menu>
  </effect>

  <script>
    <command location="inx" interpreter="python">claude_chat.py</command>
  </script>
</inkscape-extension>
